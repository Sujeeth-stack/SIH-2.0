<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 1 talks to a local API over plain HTTP during development.
  Cleartext is allowed ONLY for the loopback/emulator hosts; every other
  domain still requires HTTPS, so shipping this file does not weaken
  a production build pointed at a real https:// API.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- This machine on the Wi-Fi, for sideloaded dev builds. Change this
             if the laptop's DHCP address changes, then rebuild. -->
        <domain includeSubdomains="false">10.122.93.141</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
