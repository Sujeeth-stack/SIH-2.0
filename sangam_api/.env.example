# Copy to .env and adjust for anything that is not the local dev cluster.
# The API reads these directly from the environment.
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=sangam
PGPASSWORD=sangam_dev_pw
PGDATABASE=sangam

PORT=4000
DAILY_SUBMIT_LIMIT=20

# The live database on Render, used by ./scripts/db-show.sh.
# Render dashboard -> sangam-db -> Connections -> "External Database URL".
# It must be the EXTERNAL one; the internal hostname is only reachable from
# inside Render's network.
# Copy this file to .env (gitignored) and fill this in.
RENDER_DATABASE_URL=
